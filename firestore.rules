rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Funções Auxiliares de Validação e Segurança (Projeto: areialveiculos)
    // Compatível com autenticação híbrida do painel (SHA-256 + Firebase Auth)
    // -------------------------------------------------------------------------
    function isValidHashedPassword() {
      return 'senha' in request.resource.data
        && request.resource.data.senha is string
        && request.resource.data.senha.matches('^sha256\\$.+');
    }

    // Regra padrão segura (Zero Trust): nega coleções desconhecidas por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Configurações da loja e papel timbrado
    match /store_config/{configId} {
      allow read, write: if true;
    }

    // 1b. Configurações administrativas internas (settings)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 2. Projeção pública do catálogo para a Vitrine (SEM dados de custo ou antigo dono)
    match /vehicles_public/{vehicleId} {
      allow read: if true;
      allow create, update: if (!('valorPago' in request.resource.data) || request.resource.data.valorPago == 0)
        && (!('antigoDonoId' in request.resource.data) || request.resource.data.antigoDonoId == '');
      allow delete: if true;
    }

    // 2b. Veículos completos e dossiê contábil interno
    // Exclusão PROIBIDA se o veículo já estiver com status 'vendido'
    match /vehicles/{vehicleId} {
      allow read, create, update: if true;
      allow delete: if resource.data.status != 'vendido';
    }

    // 3. Clientes e antigos proprietários
    match /owners/{ownerId} {
      allow read, create, update, delete: if true;
    }

    // 4. Vendas, contratos e comissões
    match /sales/{saleId} {
      allow read, create, update, delete: if true;
    }

    // 5. Balanço Financeiro consolidado
    match /financial/{docId} {
      allow read, write: if true;
    }

    // 6. Modelos de minutas jurídicas, contratos e recibos
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // 7. Trilha de auditoria e Log Geral (Append-Only Imutável)
    // Alteração e exclusão permanentemente bloqueadas para integridade de auditoria
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'timestamp', 'acao', 'categoria', 'descricao', 'usuarioNome']);
      allow update, delete: if false;
    }

    // 8. Financeiras e bancos credenciados
    match /financiers/{financierId} {
      allow read, write: if true;
    }

    // 9. Equipe comercial (proibido gravar campo de senha nesta coleção)
    match /salespeople/{salespersonId} {
      allow read: if true;
      allow create, update: if !('senha' in request.resource.data);
      allow delete: if true;
    }

    // 10. Usuários do sistema (Gestores/Admins e Vendedores)
    // Senhas jamais podem ser gravadas em texto puro — exige hash SHA-256 (sha256$)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidHashedPassword();
      allow delete: if true;
    }
  }
}
